<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="DinoButton" src="project://database/Assets/LlamAcademy/Dinos/UI/Components/DinoButton.uxml?fileID=9197481963319205126&amp;guid=f7b8fc4899c149f5ac8c9f87a277368b&amp;type=3#DinoButton" />
    <Style src="project://database/Assets/LlamAcademy/Dinos/UI/RuntimeStyles.uss?fileID=7433441132597879392&amp;guid=ac05589496a7eda4294215ebcae67c02&amp;type=3#RuntimeStyles" />
    <ui:VisualElement picking-mode="Ignore" class="flex-grow">
        <ui:VisualElement name="top-bar" class="top-bar flex-row flex-end">
            <ui:VisualElement name="resources-container" class="flex-row align-center" />
        </ui:VisualElement>
        <ui:Label name="deployment-feedback" picking-mode="Ignore" text="" />
        <ui:Label name="terrain-feedback" picking-mode="Ignore" text="" />
        <ui:VisualElement name="center-content" picking-mode="Ignore" class="align-center flex-row">
            <ui:Button name="start-button" text="Start" />
        </ui:VisualElement>
        <ui:VisualElement name="status-panel" picking-mode="Ignore">
            <ui:Label name="phase-status" picking-mode="Ignore" text="Wave 0 · Setup" />
            <ui:Label name="food-status" picking-mode="Ignore" text="Food 0  (+0)" />
            <ui:Label name="threat-status" picking-mode="Ignore" text="Threat · Clear" />
        </ui:VisualElement>
        <ui:VisualElement name="bottom-bar" class="top-bar flex-row align-center">
            <ui:Label name="wave-text" picking-mode="Ignore" text="Wave 0">
                <ui:VisualElement class="underline" />
            </ui:Label>
            <ui:VisualElement name="dino-button-container" class="flex-row" />
            <ui:VisualElement class="flex-grow" />
        </ui:VisualElement>
        <ui:Button name="forfeit-button" text="Exit Battle · Defeat" style="display: none;" />
        <ui:VisualElement name="result-panel" class="result-panel" style="display: none;">
            <ui:Label picking-mode="Ignore" name="win-lose-text" text="Victory" class="hidden" />
            <ui:Label picking-mode="Ignore" name="session-summary" text="" />
            <ui:VisualElement name="comparison-panel" class="comparison-panel" style="display: none;">
                <ui:Label picking-mode="Ignore" name="comparison-status" text="" class="comparison-status" />
                <ui:VisualElement name="comparison-columns" class="result-actions">
                    <ui:Label picking-mode="Ignore" name="human-comparison-result" text="" class="comparison-result" />
                    <ui:Label picking-mode="Ignore" name="ai-comparison-result" text="" class="comparison-result" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="result-actions" class="result-actions">
                <ui:Button name="restart-button" text="Retry Layout" />
                <ui:Button name="new-layout-button" text="New Layout" />
                <ui:Button name="ai-strategy-button" text="AI Strategy" />
                <ui:Button name="select-map-button" text="Select Map" />
            </ui:VisualElement>
            <ui:VisualElement name="strategy-panel" class="strategy-panel" style="display: none;">
                <ui:Label text="Choose AI Strategy" class="strategy-title" />
                <ui:VisualElement class="strategy-options">
                    <ui:Button name="ppo-strategy-button" text="PPO" />
                    <ui:Button name="fpo-strategy-button" text="FPO" />
                    <ui:Button name="reinflow-strategy-button" text="ReinFlow" />
                </ui:VisualElement>
                <ui:Button name="close-strategy-button" text="Back" />
            </ui:VisualElement>
            <ui:Label picking-mode="Ignore" name="ai-strategy-reason" text="" class="ai-strategy-reason" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
